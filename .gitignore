# =============================================================================
# UmojaHub — .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Secrets — never commit
# -----------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# -----------------------------------------------------------------------------
# Dependencies
# -----------------------------------------------------------------------------
node_modules/
.pnp
.pnp.js

# -----------------------------------------------------------------------------
# Build outputs
# -----------------------------------------------------------------------------
.next/
out/
build/
dist/

# -----------------------------------------------------------------------------
# Test outputs
# -----------------------------------------------------------------------------
coverage/

# Playwright e2e / visual-regression harness. Baselines under
# e2e/__screenshots__/ ARE committed (they are the regression reference); the
# generated reports, traces, and minted session cookies are not.
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
e2e/.auth/

# -----------------------------------------------------------------------------
# TypeScript build cache
# -----------------------------------------------------------------------------
*.tsbuildinfo
next-env.d.ts

# -----------------------------------------------------------------------------
# Vercel
# -----------------------------------------------------------------------------
.vercel

# -----------------------------------------------------------------------------
# Default Next.js boilerplate SVGs — not part of UmojaHub branding
public/file.svg
public/globe.svg
public/next.svg
public/vercel.svg
public/window.svg

# OS and editor artefacts
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.idea/
.vscode/
*.swp
*.swo

# -----------------------------------------------------------------------------
# Claude Code operating files — AI tool config, not project source
# -----------------------------------------------------------------------------
.claude/

# -----------------------------------------------------------------------------
# Internal planning and architecture documents
# These live in the repo root for reference during development but are
# not part of the application source. Exclude from version control so the
# commit history stays focused on application code only.
# -----------------------------------------------------------------------------
API_CONTRACTS.md
BUSINESS_LOGIC.md
CLAUDE.md
ENV_REFERENCE.md
ERRORS.md
EXECUTION_PLAN.md
INSTRUCTIONS.md
PHASE_IMPLEMENTATION_MASTER.md
SCHEMA_REFERENCE.md
SEED_DATA.md
umojahub_all_documentation.md
IMPLEMENTATION_PLAN.md

# Local-only operator handbook + presentation cheat-sheet (personal, never commit)
LOCAL_DEMO_OPERATIONS.md
PRESENTATION_COMMANDS.md

.vercel

# Installed agent skills (taste-skill etc.) - local tooling
.agents/

#project paper folder
project-paper/
Undergraduate Project Paper Guidelines March, 2017.pdf

# Playwright MCP local run artifacts
.playwright-mcp/
