# UmojaHub — Environment Variables
# Copy this file to .env.local and populate all values before running the app.
# NEVER commit .env.local to source control.
# See ENV_REFERENCE.md for detailed setup instructions for each service.

# ---------------------------------------------------------------------------
# Database (MongoDB Atlas)
# Create a free M0 cluster at https://cloud.mongodb.com
# Use the eu-west-1 (Ireland) region to match Vercel's default
# ---------------------------------------------------------------------------
MONGODB_URI=

# ---------------------------------------------------------------------------
# E2E test database (Playwright only — not read by the application)
#
# The Playwright harness creates fixture users, listings, orders, mediations
# and payout requests, then DROPS the whole database when the run ends. It must
# therefore never share a database with development or demo data.
#
# Required to run `npm run test:e2e`. There is no fallback to MONGODB_URI: if
# this is missing the suite refuses to start rather than write test data into
# the database you demonstrate from. Point it at the same cluster with a
# database name reserved for testing, e.g. .../umojahub_e2e?<same options>
# ---------------------------------------------------------------------------
MONGODB_E2E_URI=

# ---------------------------------------------------------------------------
# Authentication (NextAuth.js)
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
# ---------------------------------------------------------------------------
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# ---------------------------------------------------------------------------
# OAuth providers (Decision 01-B)
# Google: create an OAuth 2.0 Client (Web) at https://console.cloud.google.com
#   Authorized redirect URI: ${NEXTAUTH_URL}/api/auth/callback/google
# GitHub: create an OAuth App at https://github.com/settings/developers
#   Authorization callback URL: ${NEXTAUTH_URL}/api/auth/callback/github
#   Request the `user:email` scope so the primary verified email is available.
# Provider↔role policy: GitHub = STUDENT only; Google = all other roles.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Admin bootstrap (AUTH-03): comma-separated Google emails provisioned as ADMIN
# on first sign-in (skips onboarding). Optional — leave empty for no allowlisted
# admins. Only applies to Google sign-ins; GitHub is never an admin path.
# Example: ADMIN_EMAIL_ALLOWLIST=ops@umojahub.com,founder@umojahub.com
ADMIN_EMAIL_ALLOWLIST=

# ---------------------------------------------------------------------------
# AI Services
# Groq API (free): https://console.groq.com — Farm Assistant, AI Mentor and
#   (by default) Education Hub brief generation.
# OpenAI API: https://platform.openai.com — knowledge-article moderation.
#
# Both keys are REQUIRED and validated at startup by src/lib/env.ts.
# ---------------------------------------------------------------------------
GROQ_API_KEY=
OPENAI_API_KEY=

# --- Model selection · all OPTIONAL, all with working defaults ---------------
#
# These exist because a provider retiring a model is an operational event, not a
# code change. On 2026-08-23 Groq stopped serving `llama-3.3-70b-versatile` to
# this account and both the Farm Assistant and the AI Mentor went silent — they
# degrade to a fallback sentence, so nothing failed loudly and every gate stayed
# green. Leave these blank unless a provider forces your hand.
#
# GROQ_MODEL: the model behind the Farm Assistant and the AI Mentor.
#   Default: openai/gpt-oss-120b
GROQ_MODEL=
#
# The Education Hub's brief generator speaks the OpenAI chat-completions shape,
# which several providers implement verbatim — so its endpoint, model and
# credential are all selectable. Defaults point at Groq.
#   BRIEF_API_URL       default: https://api.groq.com/openai/v1/chat/completions
#   BRIEF_MODEL         default: the GROQ_MODEL value above
#   BRIEF_API_KEY_VAR   default: GROQ_API_KEY — the NAME of a required env var,
#                       never a key itself. To move briefs back to OpenAI:
#                         BRIEF_API_URL=https://api.openai.com/v1/chat/completions
#                         BRIEF_MODEL=gpt-4o-mini
#                         BRIEF_API_KEY_VAR=OPENAI_API_KEY
BRIEF_API_URL=
BRIEF_MODEL=
BRIEF_API_KEY_VAR=

# ---------------------------------------------------------------------------
# GitHub App (for open-source project matching in Education Hub)
# Create a GitHub App at https://github.com/settings/apps
# ---------------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

# ---------------------------------------------------------------------------
# Payments
# PAYMENT_PROVIDER selects the payment source:
#   simulation        — production-grade simulator, no M-Pesa credentials needed (default)
#   daraja-sandbox    — real Safaricom sandbox (requires the MPESA_* vars below)
#   daraja-production  — real Safaricom production (requires the MPESA_* vars below)
# The order/webhook/trust/notification flow is identical for all three.
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=simulation

# SIMULATION_PROFILE selects WHICH payment workflow the simulator exercises.
# LEAVE IT UNSET unless you want a failure. Defined in
# src/lib/payments/simulationConfig.ts, each with a written purpose:
#   HAPPY_PATH            (default) every payment succeeds instantly.
#   TYPICAL               every failure mode appears sometimes — about 30% of
#                         payments fail and some take up to 180 seconds. It does
#                         NOT populate the demo world; the seeder writes that mix
#                         itself and never reads this setting.
#   NETWORK_TROUBLE       callbacks arrive late, twice, or never.
#   PAYMENT_FAILURE       the payment does not go through. Exercises retry.
#   RECONCILIATION_DRILL  no callback ever arrives. Exercises the sweep and
#                         the UNRESOLVED state.
# SIMULATION_PROFILE=HAPPY_PATH

# Per-outcome overrides, for a one-off scenario a named profile does not cover.
# Relative weights, not percentages. The named profiles above are the documented
# route; reach for these only when tuning something specific.
# SIMULATION_RATE_SUCCESS=75
# SIMULATION_RATE_INSUFFICIENT_FUNDS=10
# SIMULATION_RATE_USER_CANCELLED=5
# SIMULATION_RATE_TIMEOUT=5
# SIMULATION_RATE_NETWORK_FAILURE=3
# SIMULATION_RATE_LOST=2
# SIMULATION_RATE_PHONE_UNREACHABLE=0
# SIMULATION_RATE_UNKNOWN_ERROR=0
# Duplicate-callback rate, as a percentage.
# SIMULATION_DUPLICATE_RATE=2
#
# NOTE: there are no SIMULATION_DELAY_* variables. Callback delay is a property
# of the chosen profile and is not separately tunable — the five names this file
# used to list here were read by nothing.

# ---------------------------------------------------------------------------
# M-Pesa / Daraja (Safaricom) — required only when PAYMENT_PROVIDER=daraja-*
# Register at https://developer.safaricom.co.ke
# Use sandbox environment for development (MPESA_SHORTCODE=174379)
# ---------------------------------------------------------------------------
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# MUST be a real, publicly reachable HTTPS URL. Safaricom validates it when the
# STK Push is made and rejects the whole request with
#   400.002.02 · Bad Request - Invalid CallBackURL
# if it is a placeholder, http://, or localhost. Use the deployed host, or an
# ngrok tunnel in development. This was left unfilled for a long time, which
# would have failed every real payment at the first request.
MPESA_CALLBACK_URL=

# ---------------------------------------------------------------------------
# Communications
# SMTP — use any SMTP provider (Gmail, Outlook, Brevo, etc.)
# Gmail: host=smtp.gmail.com, port=587, user=your@gmail.com, pass=app-password
# SMTP_FROM is optional — defaults to SMTP_USER if not set
# Africa's Talking (SMS): https://account.africastalking.com
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
ADMIN_PHONE_NUMBER=

# ---------------------------------------------------------------------------
# Weather (OpenWeatherMap — free tier)
# Register at https://openweathermap.org/api
# ---------------------------------------------------------------------------
OPEN_WEATHER_MAP_API_KEY=

# ---------------------------------------------------------------------------
# Storage (Cloudinary)
# Register at https://cloudinary.com — free tier sufficient for MVP
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME must match CLOUDINARY_CLOUD_NAME (exposed to browser for unsigned upload)
# NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET — create an unsigned upload preset in Cloudinary settings
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ---------------------------------------------------------------------------
# Monitoring (Sentry — optional for development)
# Create a Next.js project at https://sentry.io
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Cron job security
# Generate with: openssl rand -hex 32
# ---------------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------------
# Webhook security (Daraja M-Pesa callback URL secret)
# Generate with: openssl rand -hex 32 (use a DIFFERENT value from CRON_SECRET)
# ---------------------------------------------------------------------------
WEBHOOK_SECRET=

# ── Payment demonstration (academic panel) ────────────────────────────────────
# The order keeps its true total everywhere; only the amount sent to Safaricom
# is nominal, and only when PAYMENT_MODE is set. Leave both unset in production.
# PAYMENT_MODE=REAL_STK_DEMO
# DEMO_AMOUNT=1
