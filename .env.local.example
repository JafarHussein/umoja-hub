# UmojaHub — Environment Variables
# Copy this file to .env.local and populate all values before running the app.
# NEVER commit .env.local to source control.
# See ENV_REFERENCE.md for detailed setup instructions for each service.

# ---------------------------------------------------------------------------
# Database (MongoDB Atlas)
# Create a free M0 cluster at https://cloud.mongodb.com
# Use the eu-west-1 (Ireland) region to match Vercel's default
# ---------------------------------------------------------------------------
MONGODB_URI=

# ---------------------------------------------------------------------------
# Authentication (NextAuth.js)
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
# ---------------------------------------------------------------------------
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# ---------------------------------------------------------------------------
# AI Services
# Groq API (free): https://console.groq.com — powers Farm Assistant + AI Mentor
# OpenAI API: https://platform.openai.com — powers brief generation + moderation
# ---------------------------------------------------------------------------
GROQ_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# GitHub App (for open-source project matching in Education Hub)
# Create a GitHub App at https://github.com/settings/apps
# ---------------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

# ---------------------------------------------------------------------------
# M-Pesa / Daraja (Safaricom)
# Register at https://developer.safaricom.co.ke
# Use sandbox environment for development (MPESA_SHORTCODE=174379)
# ---------------------------------------------------------------------------
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

# ---------------------------------------------------------------------------
# Communications
# Resend (free 3,000 emails/month): https://resend.com
# Africa's Talking (SMS): https://account.africastalking.com
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
ADMIN_PHONE_NUMBER=

# ---------------------------------------------------------------------------
# Weather (OpenWeatherMap — free tier)
# Register at https://openweathermap.org/api
# ---------------------------------------------------------------------------
OPEN_WEATHER_MAP_API_KEY=

# ---------------------------------------------------------------------------
# Storage (Cloudinary)
# Register at https://cloudinary.com — free tier sufficient for MVP
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME must match CLOUDINARY_CLOUD_NAME (exposed to browser for unsigned upload)
# NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET — create an unsigned upload preset in Cloudinary settings
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ---------------------------------------------------------------------------
# Monitoring (Sentry — optional for development)
# Create a Next.js project at https://sentry.io
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Cron job security
# Generate with: openssl rand -hex 32
# ---------------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------------
# Webhook security (Daraja M-Pesa callback URL secret)
# Generate with: openssl rand -hex 32 (use a DIFFERENT value from CRON_SECRET)
# ---------------------------------------------------------------------------
WEBHOOK_SECRET=
